<Window x:Class="Look.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="look" Width="1380" Height="880" MinWidth="760" MinHeight="520"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource InkBrush}"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown"
        Closed="Window_Closed" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="12,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"
                            VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="look" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ModeText" Text=" / quietly yours" Foreground="{StaticResource MutedBrush}"
                               Margin="8,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="SpaceSelector" Width="126" Margin="12,0,4,0" Padding="7,3"
                              Background="{StaticResource PanelBrush}" Foreground="{StaticResource InkBrush}"
                              BorderBrush="{StaticResource LineBrush}" FontSize="11"
                              DisplayMemberPath="Name" SelectedValuePath="Id"
                              SelectionChanged="SpaceSelector_SelectionChanged"/>
                    <Button Content="＋" Click="NewSpace_Click" ToolTip="Create a space"
                            Style="{StaticResource QuietButton}" FontSize="15"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="＋" Click="NewTab_Click"
                        Style="{StaticResource QuietButton}" FontSize="20"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="TabsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8,8,0,0" Tag="{Binding}" AllowDrop="True"
                                        PreviewMouseLeftButtonDown="Tab_PreviewMouseLeftButtonDown"
                                        PreviewMouseMove="Tab_PreviewMouseMove" DragOver="Tab_DragOver" Drop="Tab_Drop"
                                        Margin="2,8,2,0" MinWidth="112" MaxWidth="190" Height="38">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#20211F"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="#343531"/>
                                                    <Setter Property="BorderBrush" Value="#D5D5CF"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSplit}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#A9A99F"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#9C9C94"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.ContextMenu>
                                        <ContextMenu Opened="TabContextMenu_Opened">
                                            <MenuItem Header="Move to space">
                                                <MenuItem Header="Choose a space" IsEnabled="False"/>
                                            </MenuItem>
                                            <MenuItem Header="Pin / unpin tab" Click="PinTab_Click"/>
                                            <MenuItem Header="Duplicate tab" Click="DuplicateTab_Click"/>
                                            <MenuItem Header="Mute / unmute tab" Click="MuteTab_Click"/>
                                            <Separator/>
                                            <MenuItem Header="Close tab" Click="CloseTabFromMenu_Click"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <DockPanel>
                                        <Button Content="×" Tag="{Binding}" Click="CloseTab_Click"
                                                Style="{StaticResource QuietButton}" DockPanel.Dock="Right"
                                                Padding="8,2"/>
                                        <Button Content="{Binding DisplayTitle}" Tag="{Binding}"
                                                Click="SelectTab_Click" Style="{StaticResource QuietButton}"
                                                Padding="10,2"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content="‹" Click="Back_Click" Style="{StaticResource QuietButton}" FontSize="21"/>
            <Button Grid.Column="1" Content="›" Click="Forward_Click"
                    Style="{StaticResource QuietButton}" FontSize="21"/>
            <Button Grid.Column="2" Content="↻" Click="Reload_Click" Style="{StaticResource QuietButton}"/>
            <Button Grid.Column="3" Content="×" Click="Stop_Click" ToolTip="Stop loading" Style="{StaticResource QuietButton}"/>
            <Border Grid.Column="4" Background="{StaticResource PanelBrush}" CornerRadius="9"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="8,0">
                <TextBox x:Name="AddressBox" Background="Transparent" Foreground="{StaticResource InkBrush}"
                         BorderThickness="0" VerticalContentAlignment="Center" Padding="12,0"
                         FontSize="13" KeyDown="AddressBox_KeyDown"/>
            </Border>
            <Button Grid.Column="5" Content="☆" Click="Bookmark_Click" ToolTip="Add or remove bookmark" Style="{StaticResource QuietButton}" FontSize="17"/>
            <Button Grid.Column="6" Content="···" Click="Menu_Click" Style="{StaticResource QuietButton}"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid x:Name="WelcomePanel">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="460">
                    <TextBlock Text="look" FontSize="58" FontWeight="Light" HorizontalAlignment="Center"/>
                    <TextBlock Text="A little less browser. A little more browsing."
                               FontSize="14" Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,28"/>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="16">
                        <TextBox x:Name="WelcomeAddress" Background="Transparent"
                                 Foreground="{StaticResource InkBrush}" BorderThickness="0"
                                 FontSize="15" KeyDown="WelcomeAddress_KeyDown"
                                 ToolTip="Search or enter an address"/>
                    </Border>
                </StackPanel>
            </Grid>
            <Grid x:Name="BrowserHost" Visibility="Collapsed"/>
            <Border x:Name="FindBar" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,12,16,0" Padding="8" CornerRadius="9"
                    Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="FindTextBox" Width="210" Background="Transparent"
                             Foreground="{StaticResource InkBrush}" BorderThickness="0"
                             VerticalContentAlignment="Center" KeyDown="FindTextBox_KeyDown"
                             ToolTip="Find on this page"/>
                    <Button Content="↑" Click="FindPrevious_Click" Style="{StaticResource QuietButton}"/>
                    <Button Content="↓" Click="FindNext_Click" Style="{StaticResource QuietButton}"/>
                    <Button Content="×" Click="CloseFind_Click" Style="{StaticResource QuietButton}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="12,0">
                <TextBlock x:Name="FooterLabel" Text="LOOK · LOCAL FIRST" FontSize="9"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Text="Ready" FontSize="9"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
