<Window x:Class="Look.Views.BrowserLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="look — Library" Width="900" Height="650" MinWidth="680" MinHeight="460"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource InkBrush}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <DataTemplate x:Key="LibraryRowTemplate">
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Address}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding Metadata}" FontSize="10" Foreground="{StaticResource MutedBrush}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Open" Tag="{Binding}" Click="OpenEntry_Click"
                            Style="{StaticResource QuietButton}" Margin="4,0"/>
                    <Button Grid.Column="2" Content="Remove" Tag="{Binding}" Click="RemoveEntry_Click"
                            Style="{StaticResource QuietButton}" Margin="4,0"/>
                </Grid>
            </Border>
        </DataTemplate>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Library" FontSize="25" FontWeight="SemiBold"/>
            <TextBlock Text="Bookmarks, browsing history and downloads"
                       Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="9" Padding="12,0" Margin="0,0,0,10">
            <TextBox x:Name="SearchBox" Background="Transparent" Foreground="{StaticResource InkBrush}"
                     BorderThickness="0" VerticalContentAlignment="Center" FontSize="13"
                     ToolTip="Search titles and addresses" TextChanged="SearchBox_TextChanged"/>
        </Border>
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
            <TabItem Header="Bookmarks">
                <ListBox x:Name="BookmarksList" ItemTemplate="{StaticResource LibraryRowTemplate}" Margin="0,12,0,0"/>
            </TabItem>
            <TabItem Header="History">
                <ListBox x:Name="HistoryList" ItemTemplate="{StaticResource LibraryRowTemplate}" Margin="0,12,0,0"/>
            </TabItem>
            <TabItem Header="Downloads">
                <ListBox x:Name="DownloadsList" ItemTemplate="{StaticResource LibraryRowTemplate}" Margin="0,12,0,0"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
