<Window x:Class="Look.Views.TabSwitcherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Switch tab" Width="560" Height="520" MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource InkBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Switch to a tab" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Search by page title or address · Enter to open · Esc to close"
                       FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,10"/>
            <TextBox x:Name="SearchBox" Padding="11,8" FontSize="14"
                     Background="{StaticResource PanelBrush}" Foreground="{StaticResource InkBrush}"
                     BorderBrush="{StaticResource LineBrush}" TextChanged="SearchBox_TextChanged"
                     KeyDown="SearchBox_KeyDown"/>
        </StackPanel>
        <ListBox x:Name="TabsList" Grid.Row="1" BorderThickness="0"
                 Background="{StaticResource PanelBrush}" Foreground="{StaticResource InkBrush}"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 KeyDown="TabsList_KeyDown" MouseDoubleClick="TabsList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12,10" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Address}" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="2" Text="look · tab switcher" FontSize="10"
                   Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" Margin="0,10,0,0"/>
    </Grid>
</Window>
